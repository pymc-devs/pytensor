"""Types of `pytensor_llvm.ir`, the IR builder (generated from the extension's signatures)."""
from collections.abc import Callable, Sequence
from enum import Enum
from typing import Any, TypeAlias

import numpy as np

#: an operand: a value, or a Python literal that takes the type the operation needs
Operand: TypeAlias = "Value | bool | int | float"

class ICmp(Enum):
    EQ = ...
    NE = ...
    SGE = ...
    SGT = ...
    SLE = ...
    SLT = ...
    UGE = ...
    UGT = ...
    ULE = ...
    ULT = ...

class FCmp(Enum):
    OEQ = ...
    OGE = ...
    OGT = ...
    OLE = ...
    OLT = ...
    ONE = ...
    ORD = ...
    UEQ = ...
    UGE = ...
    UGT = ...
    ULE = ...
    ULT = ...
    UNE = ...
    UNO = ...

class Inline(Enum):
    Always = ...
    Default = ...
    Never = ...

class Intrinsic(Enum):
    Ceil = ...
    Copysign = ...
    Cos = ...
    Exp = ...
    Exp2 = ...
    Fabs = ...
    Floor = ...
    Fma = ...
    Log = ...
    Log10 = ...
    Log2 = ...
    Maximum = ...
    Minimum = ...
    Pow = ...
    Round = ...
    RoundEven = ...
    Sin = ...
    Sqrt = ...
    Trunc = ...

class Libm(Enum):
    Acos = ...
    Acosh = ...
    Asin = ...
    Asinh = ...
    Atan = ...
    Atan2 = ...
    Atanh = ...
    Cosh = ...
    Erf = ...
    Erfc = ...
