    Normal = ...
    Poisson = ...
    U64 = ...
    Uniform = ...

class RustMath(Enum):
    Gamma = ...
    GammaLn = ...
    Psi = ...

class Type:
    """An LLVM type: `ir.i64`, `ir.ptr`, `ir.Type.array(ir.i64, 3)`, ..."""

    @property
    def bits(self) -> int | None: ...
    @property
    def fields(self) -> list[Type] | None: ...
    @property
    def is_float(self) -> bool: ...
    @property
    def is_int(self) -> bool: ...
    @staticmethod
    def int(bits: int) -> Type: ...
    @staticmethod
    def array(elem: Type, n: int) -> Type: ...
    @staticmethod
    def struct_(fields: Sequence[Type]) -> Type: ...

void: Type
i1: Type
i8: Type
i16: Type
i32: Type
i64: Type
f32: Type
f64: Type
ptr: Type

class Value:
    """A value of a module: an instruction's result, a parameter or a constant."""

    @property
    def type(self) -> Type: ...
    @property
    def const_int(self) -> int | None:
        """The value if this is an integer constant (booleans: 0 or 1)."""
    @property
    def const_float(self) -> float | None:
        """The value if this is a float constant."""
    def named(self, name: str) -> Value:
        """Name the value in the IR text (`%name` instead of `%7`). Returns the value."""

class Function:
    @property
    def name(self) -> str: ...
    @property
    def params(self) -> list[Value]: ...
    @property
    def ret(self) -> Type: ...
    def builder(self) -> Builder:
        """A builder for the body. A function has one."""

class CompiledModule:
    def address(self, name: str) -> int: ...
    @property
    def key(self) -> str: ...
    @property
    def source(self) -> str: ...
    @property
    def compile_s(self) -> float: ...
    @property
    def total_s(self) -> float: ...

class Module:
    def __init__(self, name: str, fastmath: bool = True) -> None: ...
    @property
    def name(self) -> str: ...
    label: str
    def function(
        self, name: str, params: Sequence[Type], ret: Type, exported: bool = False, inline: Inline = ...
    ) -> Function: ...
    def ir(self) -> str:
        """The module as LLVM IR text."""
    def verify(self) -> None: ...
    def compile(self, opt_level: int = 3, cache: bool = True) -> CompiledModule: ...

def compile_many(modules: Sequence[Module], opt_level: int = 3, cache: bool = True) -> list[CompiledModule]: ...
def call_kernel(
    address: int, inputs: Sequence[np.ndarray], outputs: Sequence[Any], frame_bytes: int = 0, config: int = 0
) -> list[np.ndarray]: ...

class Loop:
    def __enter__(self) -> Value: ...
    def __exit__(self, *exc: object) -> bool: ...

class If:
    def __enter__(self) -> None: ...
    def __exit__(self, *exc: object) -> bool: ...

class Else:
    def __enter__(self) -> None: ...
    def __exit__(self, *exc: object) -> bool: ...

class Parallel:
    """`with b.parallel(ctx, n, grain) as r:` runs the body for chunks `r.start .. r.end`."""

    def __enter__(self) -> Parallel: ...
    def __exit__(self, *exc: object) -> bool: ...
    @property
    def start(self) -> Value: ...
    @property
    def end(self) -> Value: ...
    @property
    def result(self) -> Value: ...

class Builder:
    """Builds the body of one function. Every method checks its operands and raises."""

    @property
    def terminated(self) -> bool:
        """The current block has ended (with `ret`)."""
    def add(self, a: Operand, b: Operand, nsw: bool = False) -> Value:
        """`nsw`: the result doesn't overflow as a signed integer (lets LLVM simplify)."""
    def aggregate(self, ty: Type, members: Sequence[Value]) -> Value:
        """A struct or array value from its members."""
    def alias_domain(self, name: str) -> None:
        """Start alias information for this function (DESIGN.md, "Aliasing"): a scope
        domain and a TBAA root named after `name` (unique in the module).
        """
    def alloca(self, ty: Type, count: int = 1) -> Value:
        """Stack memory for `count` values of `ty`, in the entry block (64-byte aligned)."""
    def and_(self, a: Operand, b: Operand) -> Value: ...
    def ashr(self, a: Operand, b: Operand) -> Value: ...
    def call(self, f: Function, args: Sequence[Operand]) -> Value | None:
        """Call a function of this module."""
    def call_ptr(self, f: Value, args: Sequence[Value], ret: Type | None = None) -> Value | None:
        """Call the function at address `f` (a ptr value) with `args`, returning `ret`
        (None: void). For functions outside the module (kernels), whose address is only
        known at run time (loaded from the link table, not part of the IR).
        """
    def const_bool(self, value: bool) -> Value: ...
    def const_float(self, ty: Type, value: float) -> Value: ...
    def const_int(self, ty: Type, value: int) -> Value: ...
    def cstr(self, s: str) -> Value:
        """Pointer to a constant NUL-terminated string."""
    def else_(self) -> Else:
        """`with b.else_():` right after a `with b.if_(cond):` block runs the body if `cond`
        was false.
        """
    def eq(self, a: Operand, b: Operand) -> Value:
        """`a == b` (integers or pointers)."""
    def extract(self, agg: Value, index: int) -> Value: ...
    def f32(self, value: float) -> Value:
        """A float constant."""
    def f64(self, value: float) -> Value:
        """A double constant."""
    def fadd(self, a: Operand, b: Operand) -> Value: ...
    def fcmp(self, pred: FCmp, a: Operand, b: Operand) -> Value: ...
    def fdiv(self, a: Operand, b: Operand) -> Value: ...
    def field_ptr(self, ty: Type, ptr: Value, index: int) -> Value:
        """Address of field `index` of a struct of type `ty` at `ptr`."""
    def fmul(self, a: Operand, b: Operand) -> Value: ...
    def fneg(self, a: Value) -> Value: ...
    def fold(self, n: Operand, init: Sequence[Value], body: Callable[..., Value | Sequence[Value] | None], until: bool = False) -> list[Value]:
        """Loop with carried values: `acc = init; for i in 0..n: acc = body(i, *acc)`;
        returns the final values (a list). `body` returns the new values: a sequence of
        the init types, or the value itself if there is one.
        
        With `until=True` the body returns one more value, an i1 stop flag; the loop
        ends after the first step that sets it, and the flag is returned last (false
        when no step ran).
        """
    def fpext(self, v: Value, to: Type) -> Value: ...
    def fptosi(self, v: Value, to: Type) -> Value:
        """Float to signed integer. Out-of-range values give poison: clamp first if needed."""
    def fptoui(self, v: Value, to: Type) -> Value: ...
    def fptrunc(self, v: Value, to: Type) -> Value: ...
    def frem(self, a: Operand, b: Operand) -> Value: ...
    def fsub(self, a: Operand, b: Operand) -> Value: ...
    def gep(self, elem: Type, ptr: Value, index: Operand) -> Value:
        """Address of element `index` of an array of `elem` starting at `ptr` (inbounds)."""
    def gep_bytes(self, ptr: Value, offset: Operand) -> Value:
        """`ptr + offset` bytes (inbounds)."""
    def i32(self, value: int) -> Value:
        """An i32 constant."""
    def i64(self, value: int) -> Value:
        """An i64 constant."""
    def i8(self, value: int) -> Value:
        """An i8 constant."""
    def icmp(self, pred: ICmp, a: Operand, b: Operand) -> Value: ...
    def if_(self, cond: Value) -> If:
        """`with b.if_(cond):` runs the body if `cond` (i1) is true."""
    def if_else(self, cond: Value, then: Callable[..., Value | Sequence[Value] | None], else_: Callable[..., Value | Sequence[Value] | None]) -> list[Value]:
        """`then()` if `cond` else `else_()`; both return values of the same types (a
        sequence, one value, or None for none), which are merged and returned as a list.
        For branches without values, `with b.if_(cond): ...` and `with b.else_(): ...`
        read better.
        """
    def insert(self, agg: Value, value: Value, index: int) -> Value: ...
    def intrinsic(self, which: Intrinsic, args: Sequence[Operand]) -> Value:
        """A float intrinsic, overloaded on the operands' type."""
    def libm(self, which: Libm, args: Sequence[Operand]) -> Value: ...
    def load(self, ty: Type, ptr: Value, align: int | None = None) -> Value:
        """Load a value of type `ty`. `align` in bytes (default: the type's ABI alignment)."""
    def loop(self, n: Operand) -> Loop:
        """`with b.loop(n) as i:` runs the body for i = 0 .. n-1 (i64)."""
    def lshr(self, a: Operand, b: Operand) -> Value: ...
    def mark_array(self, ptr: Value, scope: str, noalias: Sequence[str]) -> None:
        """`ptr` points into an array in scope `scope` that doesn't overlap the arrays of
        scopes `noalias`. Loads and stores through it (and through pointers derived from
        it) get scoped-alias and type-based alias metadata. The caller guarantees the
        claim (written outputs of a task never overlap its inputs or each other).
        """
    def mul(self, a: Operand, b: Operand, nsw: bool = False) -> Value: ...
    def ne(self, a: Operand, b: Operand) -> Value:
        """`a != b` (integers or pointers)."""
    def neg(self, a: Value) -> Value: ...
    def not_(self, a: Value) -> Value: ...
    def null(self) -> Value:
        """The null pointer."""
    def or_(self, a: Operand, b: Operand) -> Value: ...
    def parallel(self, ctx: Value, n: Operand, grain: Operand) -> Parallel:
        """`with b.parallel(ctx, n, grain) as r:` a loop over `0..n` split into chunks of
        `grain` (i64s) that may run in parallel (the runtime's `parallel_for`). Inside the
        block, code goes into an outlined body function, called per chunk with its own
        context; `r.start`, `r.end` are the chunk's bounds. Values of the enclosing
        function used inside are captured automatically, and `ctx` stands for the
        chunk's context there. After the block, `r.result` (i32) is the runtime's result:
        nonzero if a chunk failed (the error is set on `ctx`).
        
        Chunks must not write memory another chunk reads or writes. Captured values must
        be scalars or pointers.
        """
    def ret(self, value: Operand = None) -> None:
        """Return from the function. Ends the current block."""
    def rng(self, which: Rng, ctx: Value, args: Sequence[Value] = ...) -> Value | None:
        """A libm function (`f`-suffixed for float). Advertises libmvec SIMD variants so the
        loop vectorizer can use them.
        Draw from the call context's random state: `b.rng(ir.Rng.Normal, ctx)`,
        `b.rng(ir.Rng.Gamma, ctx, [shape])`, ... Returns the value (None for the fills).
        """
    def rt_alloc(self, ctx: Value, nbytes: Operand, owner_slot: Value) -> Value:
        """A new buffer of `nbytes` (i64), 64-byte aligned. Writes the owning reference to
        `owner_slot` and returns the data pointer (null on failure, with the error set).
        """
    def rt_decref(self, ctx: Value, buffer: Value) -> None:
        """Give up a buffer reference (`buffer`: a PtBuffer pointer, may be null)."""
    def rt_fail(self, ctx: Value, message: str) -> None:
        """Report an error on `ctx` (the function should then return nonzero)."""
    def rt_scratch(self, ctx: Value, nbytes: Operand) -> Value:
        """Scratch memory: `nbytes` (i64), 64-byte aligned, valid until the task ends or an
        earlier mark is released. Null on failure, with the error set.
        """
    def rt_scratch_mark(self, ctx: Value) -> Value:
        """Mark the scratch position (an i64 token for `rt_scratch_release`)."""
    def rt_scratch_release(self, ctx: Value, mark: Value) -> None:
        """Release the scratch handed out since `mark`."""
    def rust_math(self, which: RustMath, x: Value) -> Value:
        """A scalar function precompiled in Rust."""
    def sdiv(self, a: Operand, b: Operand) -> Value:
        """Signed division. Division by zero (or MIN / -1) is undefined: check first."""
    def select(self, cond: Value, a: Operand, b: Operand) -> Value:
        """`a` if `cond` else `b`. A constant condition picks its operand."""
    def sext(self, v: Value, to: Type) -> Value: ...
    def sge(self, a: Operand, b: Operand) -> Value:
        """`a >= b`, signed."""
    def sgt(self, a: Operand, b: Operand) -> Value:
        """`a > b`, signed."""
    def shl(self, a: Operand, b: Operand) -> Value: ...
    def sitofp(self, v: Value, to: Type) -> Value: ...
    def sle(self, a: Operand, b: Operand) -> Value:
        """`a <= b`, signed."""
    def slt(self, a: Operand, b: Operand) -> Value:
        """`a < b`, signed."""
    def smax(self, a: Operand, b: Operand) -> Value:
        """The larger of two signed integers."""
    def smin(self, a: Operand, b: Operand) -> Value:
        """The smaller of two signed integers."""
    def srem(self, a: Operand, b: Operand) -> Value: ...
    def store(self, value: Value, ptr: Value, align: int | None = None) -> None: ...
    def sub(self, a: Operand, b: Operand, nsw: bool = False) -> Value: ...
    def trunc(self, v: Value, to: Type) -> Value: ...
    def udiv(self, a: Operand, b: Operand) -> Value: ...
    def uge(self, a: Operand, b: Operand) -> Value:
        """`a >= b`, unsigned."""
    def ugt(self, a: Operand, b: Operand) -> Value:
        """`a > b`, unsigned."""
    def uitofp(self, v: Value, to: Type) -> Value: ...
    def ule(self, a: Operand, b: Operand) -> Value:
        """`a <= b`, unsigned."""
    def ult(self, a: Operand, b: Operand) -> Value:
        """`a < b`, unsigned."""
    def umax(self, a: Operand, b: Operand) -> Value:
        """The larger of two unsigned integers."""
    def umin(self, a: Operand, b: Operand) -> Value:
        """The smaller of two unsigned integers."""
    def undef(self, ty: Type) -> Value: ...
    def urem(self, a: Operand, b: Operand) -> Value: ...
    def xor(self, a: Operand, b: Operand) -> Value: ...
    def zero(self, ty: Type) -> Value:
        """The all-zero value of a type (also structs and arrays)."""
    def zext(self, v: Value, to: Type) -> Value: ...
